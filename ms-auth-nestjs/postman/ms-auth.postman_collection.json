{
  "info": {
    "name": "ms-auth-nestjs",
    "description": "Colección funcional del microservicio AUTH (RS256 + RBAC dinámico). Ejecutar Login primero para poblar accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "internalBaseUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "internalApiKey", "value": "REPLACE_WITH_INTERNAL_API_KEY" },
    { "key": "userId", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "roleAnalystId", "value": "" },
    { "key": "assignmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status ok', () => pm.response.to.have.status(200));",
              "pm.test('servicio auth', () => pm.expect(pm.response.json().service).to.eql('ms-auth-nestjs'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"jperez\",\n  \"password\": \"ClaveSegura2026!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body.user) { pm.collectionVariables.set('userId', body.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        },
        {
          "name": "Me (alias)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('logout 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"1799999999\",\n  \"nombres\": \"Usuario\",\n  \"apellidos\": \"Postman\",\n  \"fechaNacimiento\": \"1995-01-01\",\n  \"username\": \"postman_user\",\n  \"email\": \"postman_user@example.com\",\n  \"telefono\": \"0999999999\",\n  \"password\": \"ClaveSegura2026!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creado', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('userId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Get user by cedula",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/cedula/1799999999", "host": ["{{baseUrl}}"], "path": ["users", "cedula", "1799999999"] }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nombres\": \"Usuario Editado\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"rol\": \"AUDITOR\"\n}" },
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('roleId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roles?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["roles"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get role by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roles/{{roleId}}", "host": ["{{baseUrl}}"], "path": ["roles", "{{roleId}}"] }
          }
        },
        {
          "name": "Update role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": false\n}" },
            "url": { "raw": "{{baseUrl}}/roles/{{roleId}}", "host": ["{{baseUrl}}"], "path": ["roles", "{{roleId}}"] }
          }
        },
        {
          "name": "Delete role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roles/{{roleId}}", "host": ["{{baseUrl}}"], "path": ["roles", "{{roleId}}"] }
          }
        }
      ]
    },
    {
      "name": "User roles",
      "item": [
        {
          "name": "Assign role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"roleId\": \"{{roleId}}\",\n  \"estado\": true\n}" },
            "url": { "raw": "{{baseUrl}}/user-roles", "host": ["{{baseUrl}}"], "path": ["user-roles"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('assignmentId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List assignments by user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user-roles/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["user-roles", "user", "{{userId}}"] }
          }
        },
        {
          "name": "Get assignment by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user-roles/{{assignmentId}}", "host": ["{{baseUrl}}"], "path": ["user-roles", "{{assignmentId}}"] }
          }
        },
        {
          "name": "Deactivate assignment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": false\n}" },
            "url": { "raw": "{{baseUrl}}/user-roles/{{assignmentId}}", "host": ["{{baseUrl}}"], "path": ["user-roles", "{{assignmentId}}"] }
          }
        },
        {
          "name": "Delete assignment by id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user-roles/{{assignmentId}}", "host": ["{{baseUrl}}"], "path": ["user-roles", "{{assignmentId}}"] }
          }
        },
        {
          "name": "Delete assignment by user and role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/user-roles/{{userId}}/{{roleId}}", "host": ["{{baseUrl}}"], "path": ["user-roles", "{{userId}}", "{{roleId}}"] }
          }
        }
      ]
    },
    {
      "name": "Internal authorization",
      "item": [
        {
          "name": "AUTHORIZATION: check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Service-Key", "value": "{{internalApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_token\": \"{{accessToken}}\",\n  \"action\": \"steganography.analyze\",\n  \"resource_id\": null\n}"
            },
            "url": { "raw": "{{internalBaseUrl}}/internal/authorization/check", "host": ["{{internalBaseUrl}}"], "path": ["internal", "authorization", "check"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('decision explicita', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('subject_id');",
                  "  pm.expect(body).to.have.property('allowed');",
                  "  pm.expect(body).to.have.property('reason');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
