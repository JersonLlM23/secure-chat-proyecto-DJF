NODE_ENV=development

SWAGGER_ENABLED=false

PORT=3001

CORS_ORIGINS=http://localhost:3000

# Solamente configurar si existe un proxy/gateway confiable
TRUST_PROXY=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=user_app
DB_PASSWORD=User_DB_2026.Change.This.Password
DB_DATABASE=user_db

DB_SSL=false

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000

# RS256. Generar con:
#   mkdir keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/private.pem
#   openssl rsa -pubout -in keys/private.pem -out keys/public.pem
# La clave privada NUNCA debe versionarse ni incluirse en la imagen Docker.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=ms-auth
JWT_AUDIENCE=secure-chat-api

# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_256_BIT_SERVICE_KEY
