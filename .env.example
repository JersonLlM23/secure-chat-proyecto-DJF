# ---------------------------------------------------------------------------
# Docker Compose raiz: AUTH + STEGO
# Plantilla de variables de entorno para el Compose unificado.
# Copiar este archivo como `.env` y configurar las credenciales seguras.
# Las contrasenas y la API key deben tener al menos 12 y 43 caracteres
# respectivamente. No utilizar valores de ejemplo en produccion.
# ---------------------------------------------------------------------------

NODE_ENV=production
SWAGGER_ENABLED=true

# Puertos publicados unicamente en 127.0.0.1 en el host.
AUTH_PORT=3001
STEGO_PORT=3002

CORS_ORIGINS=http://localhost:3000

# Solo configurar si existe un proxy/gateway confiable.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# PostgreSQL de AUTH (volumen existente: ms-auth-nestjs_users_postgres_data)
# Debe coincidir con las credenciales del volumen de la BD de AUTH.
# ---------------------------------------------------------------------------
AUTH_DB_USERNAME=user_app
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_DB_DATABASE=user_db

# ---------------------------------------------------------------------------
# PostgreSQL de STEGO (volumen existente: ms-stego-nestjs_stego_postgres_data)
# Debe coincidir con las credenciales del volumen de la BD de STEGO.
# ---------------------------------------------------------------------------
STEGO_DB_USERNAME=stego_user
STEGO_DB_PASSWORD=CHANGE_ME_STEGO_DB_PASSWORD
STEGO_DB_DATABASE=stego_db

# ---------------------------------------------------------------------------
# JWT RS256. AUTH firma con la privada; STEGO solo recibe la publica.
# ---------------------------------------------------------------------------
JWT_ISSUER=ms-auth
JWT_AUDIENCE=secure-chat-api
JWT_EXPIRES_IN_SECONDS=900

# Credencial de servicio compartida entre AUTH y STEGO para /internal/authorization/check
# Debe tener >= 256 bits de entropia. Generar con: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_64_HEX_CHAR_SERVICE_KEY

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_BLOCK_MS=60000

# ---------------------------------------------------------------------------
# STEGO
# ---------------------------------------------------------------------------
AUTH_TIMEOUT_MS=3000
MAX_FILE_SIZE_BYTES=10485760
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000
STEGO_SUSPICIOUS_THRESHOLD=0.75
STEGO_CLEAR_THRESHOLD=0.55
