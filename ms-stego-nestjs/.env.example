NODE_ENV=development

SWAGGER_ENABLED=false

PORT=3002

CORS_ORIGINS=http://localhost:3000

# Solamente configurar si existe un proxy/gateway confiable
TRUST_PROXY=

# 5433 evita el choque con la base de datos local de AUTH (5432).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=stego_user
DB_PASSWORD=CHANGE_ME_STEGO_DB_PASSWORD
DB_DATABASE=stego_db

DB_SSL=false

# RS256. STEGO solo necesita la clave pública que emite AUTH.
# Copiar keys/public.pem desde ms-auth-nestjs o generarla con:
#   openssl rsa -pubout -in ms-auth-nestjs/keys/private.pem -out keys/public.pem
# La clave privada NUNCA debe estar disponible para STEGO.
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=ms-auth
JWT_AUDIENCE=secure-chat-api

# Endpoint interno de AUTH y credencial de servicio compartida.
# INTERNAL_API_KEY debe coincidir con la de ms-auth-nestjs.
AUTH_INTERNAL_URL=http://localhost:3001
AUTH_TIMEOUT_MS=3000
INTERNAL_API_KEY=CHANGE_ME_WITH_A_RANDOM_256_BIT_SERVICE_KEY

# Límites de carga y decodificación.
MAX_FILE_SIZE_BYTES=10485760
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=40000000

# Umbrales experimentales del análisis LSB (requieren calibración).
STEGO_SUSPICIOUS_THRESHOLD=0.75
STEGO_CLEAR_THRESHOLD=0.55
